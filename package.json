{
  "name": "iblis-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Iblis — local-first AI music workstation. Monorepo root (Node side). The PHP site lives in apps/site and is managed by composer.",
  "scripts": {
    "unused": "knip",
    "dupes": "jscpd"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "dependency-cruiser": "^18.4.0",
    "jscpd": "^5.3.1",
    "knip": "^6.37.0"
  }
}
