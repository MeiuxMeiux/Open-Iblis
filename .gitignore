packages/plugin-sdk/api-docs/

# electron-builder
apps/shell/release/
apps/shell/dist/
apps/shell/.vite/
apps/shell/.media-test/

# python (only used in dev tooling, never runtime)
__pycache__/
*.pyc
.venv/
venv/

# php
apps/site/vendor/
apps/admin/vendor/
apps/site/.phpunit.cache/
apps/site/composer.phar

# open-source export work tree + pinned scanners (see oss/)
.oss-work/
.oss-tools/

# logs / temp
.catalog-stage/
# training-pack build cache + stage (multi-GB downloads; see tools/training-pack)
.training-pack-cache/
*.log
logs/
tmp/
.tmp/
*.swp
*.swo

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
