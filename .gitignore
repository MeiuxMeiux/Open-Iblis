!apps/shell/electron/main/keys/catalog.pub.pem
!apps/shell/electron/main/keys/license.pub.pem
!apps/shell/electron/main/keys/release.pub.pem

# node / pnpm
node_modules/
.pnpm-store/
.npm/
.yarn/

# build outputs
dist/
build/
out/
release/
*.tsbuildinfo
coverage/
