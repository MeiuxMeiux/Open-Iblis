{
  "name": "@iblis/shell",
  "version": "0.0.0",
  "private": true,
  "description": "Iblis — Soulless Music.",
  "author": "Meiux Meiux LLC",
  "license": "GPL-3.0-or-later",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "vitest run -c vitest.e2e.config.mts",
    "electron:install": "install-electron --no",
    "deps": "depcruise electron src shared --config .dependency-cruiser.cjs --ignore-known"
  },
  "dependencies": {
    "@iblis/plugin-sdk": "workspace:*",
    "aubiojs": "0.2.1",
    "electron-updater": "^6.8.9",
    "essentia.js": "0.1.3",
    "extract-zip": "^2.0.1",
    "music-tempo": "1.0.3"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/istanbul-lib-coverage": "1.0.1",
    "ast-v8-to-istanbul": "1.0.7",
    "axe-core": "^4.13.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
