{
  "$comment": "Authoring source for the ACE-Step 1.5 engine pack. `just catalog-build` reads this, hashes the first-party assets that declare a local `file`, and copies the inline sha256/bytes for vendor-direct assets (the GGUFs, fetched straight from HuggingFace \u2014 never mirrored to GCS for the alpha). Since 0.1.5 the native closure is published to GCS by engine-build.yml's publish job and transcribed with `just engine-pack-transcribe` (no local dist/ staging); the notices ship as installed assets (EULA staged by `just engine-notices-stage`). Historic note: the exe + its full DLL closure (ggml{,-base,-cpu,-cuda}.dll, the CUDA runtime cudart/cublas/cublasLt, and the MSVC runtime vcruntime140{,_1}/msvcp140/concrt140) MUST be staged at packages/plugins/acestep-engine/dist/ before building (they are gitignored; see UPSTREAM.txt 'Staging'). vcomp140.dll dropped in 0.1.3: the engine builds with GGML_OPENMP=OFF and no longer links MSVC OpenMP. The exe + ggml DLLs are ABI-matched \u2014 stage them from the SAME engine-build run; the CUDA/MSVC DLLs come from the toolkit and vcrt-stage.yml. GPU/CUDA-only for the alpha: the binary is the CUDA build and CPU is unusably slow.",
  "id": "mx.iblis.engine.acestep",
  "name": "ACE-Step 1.5",
  "version": "0.1.4",
  "kind": "engine",
  "hostMinVersion": "0.2.0-alpha.1",
  "capabilities": [
    "text-to-music"
  ],
  "executable": {
    "bin": "ace-server.exe",
    "portArg": "--port",
    "args": [
      "--models",
      ".",
      "--host",
      "127.0.0.1",
      "--keep-loaded"
    ],
    "healthPath": "/health",
    "healthTimeoutMs": 300000,
    "idleUnloadMinutes": 30
  },
  "presets": [
    {
      "id": "fast",
      "name": "Fast",
      "minVramMb": 4000
    },
    {
      "id": "balanced",
      "name": "Balanced",
      "minVramMb": 6000
    },
    {
      "id": "quality",
      "name": "Quality",
      "minVramMb": 12000
    }
  ],
  "license": "MIT",
  "author": {
    "name": "Meiux Meiux LLC",
    "url": "https://iblis.meiuxmeiux.com"
  },
  "bugUrl": "https://iblis.meiuxmeiux.com/contact",
